---
import type { MarkdownHeading } from "astro";
import FloatingButton from "@/components/common/FloatingButton.astro";
import { sidebarLayoutConfig } from "@/config/sidebarConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import "@/styles/toc.css";
import { computeTocItems } from "@/utils/toc-shared";

interface Props {
	headings: MarkdownHeading[];
	encrypted?: boolean;
}

const { headings = [], encrypted = false } = Astro.props;

// 加密文章不在服务端渲染目录（避免标题泄露），交由客户端解密后生成
const items = encrypted ? [] : computeTocItems(headings, { maxLevel: 3 });

// 检查侧边栏目录组件是否启用
const sidebarTocComponent = sidebarLayoutConfig.rightComponents?.find(
	(c) => c.type === "sidebarToc",
);
const isSidebarTocEnabled = sidebarTocComponent?.enable ?? false;
const sidebarPosition = sidebarLayoutConfig.position;
const hideSidebarOnPostPage =
	sidebarLayoutConfig.hideSidebarOnPostPage === true;
---

<!-- 悬浮TOC按钮 -->
<div id="floating-toc-wrapper" class="floating-toc-wrapper" data-is-sidebar-toc-enabled={String(isSidebarTocEnabled)} data-sidebar-position={sidebarPosition} data-show-both-sidebars-on-post={String(sidebarLayoutConfig.showBothSidebarsOnPostPage ?? false)} data-floating-hide-sidebar-on-post={String(hideSidebarOnPostPage)}>
  <FloatingButton
    id="floating-toc-btn"
    icon="material-symbols:format-list-bulleted"
    toggleIcon="material-symbols:close"
    ariaLabel={i18n(I18nKey.tableOfContents)}
    ariaControls="floating-toc-panel"
    ariaExpanded={false}
    onclick="window.toggleFloatingTOC()"
    class="hide"
  />

  <!-- 悬浮TOC面板 - 移到 Wrapper 内部以便相对定位 -->
  <nav
    id="floating-toc-panel"
    aria-label={i18n(I18nKey.tableOfContents)}
    aria-hidden="true"
    class="floating-toc-panel hide overflow-hidden rounded-lg shadow-2xl backdrop-blur-lg border border-white/20 dark:border-white/10 md:w-80 w-[calc(100vw-2rem)] md:max-h-96 max-h-[calc(100vh-8rem)] py-3"
    style="background-color: var(--card-bg-transparent);"
    >
    <div class="toc-scroll-container px-3">
        <div
        class="toc-content"
        id="floating-toc-content"
        style="width: 100%; max-width: 100%;"
        >
        {!encrypted && items.length > 0 && (
          <>
            {items.map((item) => (
              <a
                href={item.href}
                class={`toc-item toc-level-${item.depthLevel}`}
                data-heading-id={item.headingId}
                aria-label={item.text}
                title={item.text}
              >
                <div class={`toc-badge ${item.badgeKind === "index" ? "toc-badge-index" : ""}`}>
                  {item.badgeKind === "index" ? (
                    item.badgeIndex
                  ) : item.badgeKind === "dot" ? (
                    <span class="toc-badge-dot"></span>
                  ) : (
                    <span class="toc-badge-dot toc-badge-dot-sm"></span>
                  )}
                </div>
                <div class={`toc-label ${item.labelPrimary ? "toc-label-primary" : "toc-label-secondary"}`}>
                  {item.text}
                </div>
              </a>
            ))}
            <div id="floating-active-indicator" class="toc-active-indicator" style="opacity: 0;"></div>
          </>
        )}
        {!encrypted && items.length === 0 && (
          <div class="text-center py-8 text-gray-500 dark:text-gray-400">
            <p>{i18n(I18nKey.tocEmpty)}</p>
          </div>
        )}
        {/* 加密文章：留空，客户端解密后由 TOCManager 填充 */}
        </div>
    </div>
  </nav>
</div>

<style lang="stylus">
.floating-toc-wrapper
	position: relative
	z-index: 999
	overflow: visible

.floating-toc-panel
	position: absolute
	bottom: calc(100% + 1rem)
	right: 0
	transition: transform 0.24s ease, opacity 0.2s ease, visibility 0.2s ease
	transform: translateY(20px)
	opacity: 0
	pointer-events: none
	overflow: hidden
	box-sizing: border-box
	backdrop-filter: blur(20px)
	-webkit-backdrop-filter: blur(20px)
	z-index: 1001
	
	&.show
		transform: translateY(0)
		opacity: 1
		pointer-events: auto
		
	&.hide
		transform: translateY(20px)
		opacity: 0
		pointer-events: none
		visibility: hidden

/* 桌面端使用不占文章宽度的右侧悬浮目录轨。 */
@media (min-width: 1025px)
	.floating-toc-wrapper
		position: fixed
		top: 50%
		right: 0
		transform: translateY(-50%)
		width: 2.75rem
		height: 3rem
		z-index: 1002

	:global(#floating-toc-btn)
		position: relative
		z-index: 1002
		width: 2.75rem
		height: 3rem
		border-right: 0
		border-radius: 0.75rem 0 0 0.75rem
		box-shadow: var(--shadow-button)

		:global(button)
			border-radius: 0.75rem 0 0 0.75rem

	.floating-toc-panel,
	.floating-toc-panel.show,
	.floating-toc-panel.hide
		top: 50%
		right: calc(100% - 0.25rem)
		bottom: auto
		width: 20rem
		max-width: calc(100vw - 5rem)
		max-height: unquote("min(70vh, 32rem)")
		transform: translate(0.75rem, -50%) scale(0.98)
		transform-origin: right center
		opacity: 0
		visibility: hidden
		pointer-events: none

	.floating-toc-wrapper:hover .floating-toc-panel,
	.floating-toc-wrapper:focus-within .floating-toc-panel
		transform: translate(0, -50%) scale(1)
		opacity: 1
		visibility: visible
		pointer-events: auto

	.floating-toc-panel .toc-scroll-container
		max-height: unquote("calc(min(70vh, 32rem) - 1.5rem)")
		
.toc-scroll-container
	/* 面板 max-height 24rem 减去面板自身 py-3 上下共 1.5rem */
	max-height: calc(24rem - 1.5rem)

	@media (max-width: 768px)
		max-height: calc(24rem - 1.5rem)

/* 响应式调整 - 仅保留 Panel 尺寸调整 */
@media (max-width: 1024px)
	.floating-toc-panel
		width: calc(100vw - 2rem)
		max-width: 20rem
		max-height: 20rem

@media (max-width: 768px)
	.floating-toc-panel
		width: calc(100vw - 1.5rem)
		max-width: 20rem
		max-height: 28rem
		bottom: calc(100% + 1rem)

/* 暗色主题半透明效果 */
:global(.dark) .floating-toc-panel
	backdrop-filter: blur(20px)
	-webkit-backdrop-filter: blur(20px)

@media (prefers-reduced-motion: reduce)
	.floating-toc-panel
		transition: none
</style>

<script>
  import { TOCManager, isPostPage } from "@/utils/toc-utils";

  // 从 data 属性读取配置
  const wrapper = document.querySelector('.floating-toc-wrapper');
  const isSidebarTocEnabled = wrapper?.getAttribute('data-is-sidebar-toc-enabled') === 'true';
	const desktopRailQuery = window.matchMedia('(min-width: 1025px)');

  if (typeof window.FloatingTOC === "undefined") {
    window.FloatingTOC = {
      btn: null,
      panel: null,
      manager: null,
      isPostPage: isPostPage // 使用导入的工具函数
    };
  }

  // 切换 TOC 面板（按钮图标随开关在 列表/X 之间切换）
  window.toggleFloatingTOC = function () {
    const panel = window.FloatingTOC.panel;
    const btn = window.FloatingTOC.btn;
    if (!panel) return;
		if (desktopRailQuery.matches) return;

    const isHidden = panel.classList.contains("hide");
    if (isHidden) {
      panel.classList.remove("hide");
      panel.classList.add("show");
      btn?.classList.add("toggled");
			updateTOCAccessibilityState(true);
    } else {
      panel.classList.remove("show");
      panel.classList.add("hide");
      btn?.classList.remove("toggled");
			updateTOCAccessibilityState(false);
    }
  };

	function updateTOCAccessibilityState(expanded: boolean) {
		const button = window.FloatingTOC.btn?.querySelector('button');
		button?.setAttribute('aria-expanded', String(expanded));
		window.FloatingTOC.panel?.setAttribute('aria-hidden', String(!expanded));
	}

  // 关闭 TOC 面板
  function closeTOC() {
    const panel = window.FloatingTOC.panel;
    const btn = window.FloatingTOC.btn;
    if (panel && !panel.classList.contains("hide")) {
      panel.classList.add("hide");
      panel.classList.remove("show");
    }
    btn?.classList.remove("toggled");
		updateTOCAccessibilityState(false);
  }

	function setupHoverRail() {
		const tocWrapper = document.getElementById('floating-toc-wrapper');
		if (!tocWrapper || tocWrapper.dataset.hoverRailBound === 'true') return;

		tocWrapper.dataset.hoverRailBound = 'true';
		const syncExpandedState = () => {
			if (!desktopRailQuery.matches) return;
			updateTOCAccessibilityState(tocWrapper.matches(':hover, :focus-within'));
		};

		tocWrapper.addEventListener('pointerenter', syncExpandedState);
		tocWrapper.addEventListener('pointerleave', syncExpandedState);
		tocWrapper.addEventListener('focusin', syncExpandedState);
		tocWrapper.addEventListener('focusout', () => requestAnimationFrame(syncExpandedState));
		tocWrapper.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !desktopRailQuery.matches) return;
			(event.target as HTMLElement).blur();
			updateTOCAccessibilityState(false);
		});
		desktopRailQuery.addEventListener('change', () => {
			closeTOC();
			updateFloatingTOCVisibility();
		});
	}

  // 设置自动关闭功能
  function setupAutoClose() {
    // 监听页面卸载和隐藏
    window.addEventListener("beforeunload", closeTOC);
    window.addEventListener("pagehide", closeTOC);
    window.addEventListener("popstate", closeTOC);
    
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) closeTOC();
    });

    // 监听 Astro 页面切换
    document.addEventListener("astro:page-load", closeTOC);
    document.addEventListener("astro:before-preparation", closeTOC);

    // 监听 hashchange（排除TOC内部导航）
    window.addEventListener("hashchange", () => {
      if (!window.tocInternalNavigation) {
        closeTOC();
      }
      window.tocInternalNavigation = false;
    });

    // 监听外部链接点击
    document.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      const link = target?.closest("a");
      if (!link || !link.href) return;

      const href = link.getAttribute("href");
      const isExternalLink = href && !href.startsWith("#") && !href.startsWith("javascript:");
      
      if (isExternalLink && !window.tocInternalNavigation) {
        const tocPanel = document.getElementById("floating-toc-panel");
        if (!tocPanel || !tocPanel.contains(link)) {
          closeTOC();
        }
      }
    });

    // 拦截 history API
    const originalPushState = history.pushState;
    const originalReplaceState = history.replaceState;

    history.pushState = function (...args) {
      closeTOC();
      return originalPushState.apply(this, args);
    };

    history.replaceState = function (...args) {
      closeTOC();
      return originalReplaceState.apply(this, args);
    };
  }

  // 检查是否应该显示悬浮目录
  function shouldShowFloatingTOC() {
    // 检查是否为文章页面
    if (!window.FloatingTOC.isPostPage()) {
      return false;
    }

    const wrapper = document.querySelector('.floating-toc-wrapper');
    const sidebarPosition = wrapper?.getAttribute('data-sidebar-position') || 'left';
    const showBothSidebarsOnPost = wrapper?.getAttribute('data-show-both-sidebars-on-post') === 'true';
    const hideSidebarOnPost = wrapper?.getAttribute('data-floating-hide-sidebar-on-post') === 'true';

    // 侧边栏在文章页隐藏时，始终显示悬浮目录
    if (hideSidebarOnPost) {
      return true;
    }

    // 双侧边栏模式（含文章页临时双侧栏）：小屏幕或侧边栏目录未启用时显示悬浮目录
    const effectiveIsBothSidebars = sidebarPosition === 'both' || showBothSidebarsOnPost;
    if (effectiveIsBothSidebars) {
      const isSmallScreen = window.innerWidth < 1280;
      return isSmallScreen || !isSidebarTocEnabled;
    }

    // 单侧边栏模式（left或right），对侧没有侧边栏目录，始终显示悬浮目录
    return true;
  }

  // 更新悬浮目录的显示状态
  function updateFloatingTOCVisibility() {
    const btn = window.FloatingTOC.btn;
    if (!btn) return;

    if (shouldShowFloatingTOC()) {
      btn.classList.remove("hide");
    } else {
      btn.classList.add("hide");
      // 同时关闭面板
      closeTOC();
    }
  }

  // 初始化 FloatingTOC
  async function initFloatingTOC() {
    window.FloatingTOC.btn = document.getElementById("floating-toc-btn");
    window.FloatingTOC.panel = document.getElementById("floating-toc-panel");

    if (!window.FloatingTOC.btn || !window.FloatingTOC.panel) {
      return;
    }

    // 更新显示状态
    updateFloatingTOCVisibility();
		setupHoverRail();

    try {
      // 清理旧实例
      if (window.FloatingTOC.manager) {
        window.FloatingTOC.manager.cleanup();
      }

      // 创建新实例
      window.FloatingTOC.manager = new TOCManager({
        contentId: "floating-toc-content",
        indicatorId: "floating-active-indicator",
        maxLevel: 3,
        scrollOffset: 80,
      });

      // attach() 自校正：SSR 锚点与当前正文一致则直接附着；
      // 缺失或过时（加密未解密/异常情况）则自动回退 DOM 遍历重建。
      window.FloatingTOC.manager.attach();

      // 设置点击事件 - 标记为 TOC 内部导航
      const tocContent = document.getElementById("floating-toc-content");
      if (tocContent) {
        tocContent.addEventListener("click", (e) => {
          const target = e.target as Element | null;
          const anchor = target?.closest('a[href^="#"]');
          if (anchor) {
            window.tocInternalNavigation = true;
          }
        }, { capture: true });
      }

      // 设置自动关闭
      setupAutoClose();
    } catch (error) {
      console.error("Failed to load TOCManager:", error);
    }
  }

  // 初始化
  initFloatingTOC();

  // 监听页面切换事件
  if (typeof window !== "undefined" && !window.floatingTOCListenersInitialized) {
    window.floatingTOCListenersInitialized = true;

    // Swup 路由切换
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(initFloatingTOC, 100);
    });
    
    // Astro 页面切换事件
    document.addEventListener("astro:page-load", () => {
      setTimeout(initFloatingTOC, 100);
    });
    
    // 浏览器导航事件
    window.addEventListener("popstate", () => {
      setTimeout(initFloatingTOC, 200);
    });

    // 监听布局模式切换（通过自定义事件）
    window.addEventListener('layoutChange', () => {
      updateFloatingTOCVisibility();
    });

    // 密码解密后重新初始化 TOC
    document.addEventListener("password:decrypted", () => {
      setTimeout(initFloatingTOC, 200);
    });

    // 监听窗口大小变化
    let resizeTimeout: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        updateFloatingTOCVisibility();
      }, 300);
    });
  }
</script>
